{
  "name": "stellartrade",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm --workspace=@stellartrade/shared run build && npm --workspace=@stellartrade/server run build && npm --workspace=@stellartrade/client run build",
    "test": "npm run --workspaces test",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run --prefix packages/server dev",
    "dev:client": "npm run --prefix packages/client dev",
    "start": "node packages/server/dist/server.js"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "^5.7.3"
  }
}
